From c271d3edd2e8790ab16864360346345890efc4c4 Mon Sep 17 00:00:00 2001
From: James Robertson <jrobertson@anaconda.com>
Date: Fri, 6 Mar 2026 14:38:12 +0000
Subject: [PATCH] Force bundled OneDNN build, enable experimental kernels, and
 fix linking
---
 cmake/Dependencies.cmake | 40 ++++++++++++++++++++++++++++++++++++----
 1 file changed, 32 insertions(+), 8 deletions(-)

Index: pytorch-2.12.0-rc3/cmake/Dependencies.cmake
===================================================================
--- pytorch-2.12.0-rc3.orig/cmake/Dependencies.cmake
+++ pytorch-2.12.0-rc3/cmake/Dependencies.cmake
@@ -1522,14 +1522,38 @@ if(NOT INTERN_BUILD_MOBILE)
     endif()
   endif()
   if(USE_MKLDNN)
-    include(${CMAKE_CURRENT_LIST_DIR}/public/mkldnn.cmake)
-    if(MKLDNN_FOUND)
-      set(AT_MKLDNN_ENABLED 1)
-      include_directories(AFTER SYSTEM ${MKLDNN_INCLUDE_DIR})
-    else()
-      message(WARNING "MKLDNN could not be found.")
-      caffe2_update_option(USE_MKLDNN OFF)
-    endif()
+    # FIX: Force bundled MKLDNN build to generate dnnl_config.h
+    set(MKLDNN_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+    set(MKLDNN_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+    set(DNNL_EXPERIMENTAL_UKERNEL ON CACHE BOOL "" FORCE)
+    add_subdirectory(${PROJECT_SOURCE_DIR}/third_party/ideep/mkl-dnn)
+
+    if("$ENV{blas_impl}" STREQUAL "mkl" AND TARGET dnnl)
+      # AR OpenMP policy: MKL builds must link Intel OpenMP, not the
+      # compiler-default OpenMP runtime (vcomp on MSVC, libgomp on gcc).
+      # See perseverance-skills/sections/02_Package_building/02_Recipes/Pinnings.md
+      if(MSVC)
+        find_library(ANACONDA_INTEL_OPENMP_LIBRARY NAMES libiomp5md REQUIRED)
+        target_link_options(dnnl PRIVATE "/nodefaultlib:vcomp")
+      else()
+        find_library(ANACONDA_INTEL_OPENMP_LIBRARY NAMES iomp5 REQUIRED)
+        # On gcc, -fopenmp auto-adds -lgomp at link. Use --as-needed so the
+        # linker drops -lgomp once iomp5 satisfies all omp_* symbols.
+        target_link_options(dnnl PRIVATE "-Wl,--as-needed")
+      endif()
+      target_link_libraries(dnnl PRIVATE "${ANACONDA_INTEL_OPENMP_LIBRARY}")
+    endif()
+
+    # 1. OneDNN Source Headers (dnnl_graph.hpp)
+    include_directories(AFTER SYSTEM ${PROJECT_SOURCE_DIR}/third_party/ideep/mkl-dnn/include)
+    # 2. OneDNN Generated Config (dnnl_config.h)
+    include_directories(AFTER SYSTEM ${PROJECT_BINARY_DIR}/third_party/ideep/mkl-dnn/include)
+    # 3. IDEEP Wrapper Headers (ideep.hpp)
+    include_directories(AFTER SYSTEM ${PROJECT_SOURCE_DIR}/third_party/ideep/include)
+
+    set(MKLDNN_FOUND TRUE)
+    set(AT_MKLDNN_ENABLED 1)
+    list(APPEND Caffe2_DEPENDENCY_LIBS dnnl)
   else()
     message("disabling MKLDNN because USE_MKLDNN is not set")
   endif()
