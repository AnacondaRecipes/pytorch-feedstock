From: Anaconda recipe maintenance <pkg-team@anaconda.com>
Subject: [PATCH] win-arm64: shard python_functions + /Od on binding glue (correct scope)

The generated python_functions_N.cpp autograd-binding TUs each need ~15GB to
compile with MSVC /O2 targeting arm64 (template-instantiation blowup), over the
16GB PBP win-arm64 worker watchdog. The peak is a FIXED per-TU cost (halving
shard size and serializing left it unchanged at ~15.6GB), so the fix must lower
per-TU compiler memory, not scheduling.

  1. num_shards 5->10 (gen_autograd_functions.py) + matching caffe2
     GENERATED_CXX_PYTHON list (both must agree or autograd regs are dropped).
  2. /Od on the generated binding glue (not perf-critical) to drop the
     optimizer spike. Placed in torch/CMakeLists.txt, which DEFINES the
     torch_python target that compiles these sources -- set_source_files_
     properties is directory-scoped, so the earlier caffe2 placement was
     silently ignored.

win-arm64-only via meta.yaml patch selector.

diff --git a/caffe2/CMakeLists.txt b/caffe2/CMakeLists.txt
index bf0e3f0..d91fa59 100644
--- a/caffe2/CMakeLists.txt
+++ b/caffe2/CMakeLists.txt
@@ -292,6 +292,11 @@ set(GENERATED_CXX_PYTHON
   "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_2.cpp"
   "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_3.cpp"
   "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_4.cpp"
+  "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_5.cpp"
+  "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_6.cpp"
+  "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_7.cpp"
+  "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_8.cpp"
+  "${TORCH_SRC_DIR}/csrc/autograd/generated/python_functions_9.cpp"
   "${TORCH_SRC_DIR}/csrc/autograd/generated/python_variable_methods.cpp"
   "${TORCH_SRC_DIR}/csrc/autograd/generated/python_torch_functions_0.cpp"
   "${TORCH_SRC_DIR}/csrc/autograd/generated/python_torch_functions_1.cpp"
diff --git a/tools/autograd/gen_autograd_functions.py b/tools/autograd/gen_autograd_functions.py
index 002a551..2a6471b 100644
--- a/tools/autograd/gen_autograd_functions.py
+++ b/tools/autograd/gen_autograd_functions.py
@@ -568,7 +568,7 @@ def gen_autograd_functions_python(
     template_path: str,
 ) -> None:
     fm = FileManager(install_dir=out, template_dir=template_path, dry_run=False)
-    num_shards = 5
+    num_shards = 10
     fm.write(
         "python_functions.h",
         lambda: {
diff --git a/torch/CMakeLists.txt b/torch/CMakeLists.txt
index 4f7d6da..3982bd8 100644
--- a/torch/CMakeLists.txt
+++ b/torch/CMakeLists.txt
@@ -390,6 +390,18 @@ set_source_files_properties(
     PROPERTIES GENERATED TRUE
     )
 
+# win-arm64 memory workaround: the generated Python-binding TUs are autograd
+# registration glue (not perf-critical); under MSVC/arm64 the /O2 optimizer
+# needs ~15GB per shard (template blowup), over the 16GB PBP worker watchdog.
+# /Od removes that optimizer spike. Correct scope: this file defines the
+# torch_python target that compiles these sources, so the property attaches.
+if(MSVC)
+  set_source_files_properties(
+    ${GENERATED_CXX_PYTHON}
+    PROPERTIES COMPILE_FLAGS "/Od"
+    )
+endif()
+
 # Disable certain warnings for GCC-9.X
 if(CMAKE_COMPILER_IS_GNUCXX)
   set_source_files_properties(${TORCH_SRC_DIR}/csrc/Module.cpp PROPERTIES COMPILE_FLAGS "-Wno-cast-function-type")
