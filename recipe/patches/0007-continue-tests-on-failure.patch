From: Xianglong Kong <xkong@anaconda.com>
Date: Wed, 14 Oct 2026 18:00:42 -0500
Subject: [PATCH] Continue tests on failure

---
 test/run_test.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/run_test.py b/test/run_test.py
index 57f6c50..406b180 100644
--- a/test/run_test.py
+++ b/test/run_test.py
@@ -1343,7 +1343,7 @@ def get_pytest_args(options, is_cpp_test=False, is_distributed_test=False):
     else:
         # When under the normal mode, retry a failed test NUM_PYTEST_RERUNS more times.
         # -x means stop at the first failure. Set PYTORCH_NUM_PYTEST_RERUNS=0 to disable.
-        rerun_options = ["-x", f"--reruns={NUM_PYTEST_RERUNS}"]
+        rerun_options = [f"--reruns={NUM_PYTEST_RERUNS}"]
 
     pytest_args = [
         "-vv",
