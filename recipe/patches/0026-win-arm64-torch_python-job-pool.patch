From 774979bacea4ea69b65e0002898c0861ccff77ce Mon Sep 17 00:00:00 2001
From: Xianglong Kong <xkong@anaconda.com>
Date: Wed, 14 Oct 2026 18:00:42 -0500
Subject: [PATCH] win-arm64: give torch_python its own ninja compile job pool

Add an opt-in TORCH_PYTHON_JOB_POOL cache variable that puts only the
torch_python target (the generated autograd-binding TUs) in a separate,
smaller ninja job pool, so the rest of the build can run at full
parallelism. No-op unless the variable is set.

win-arm64-only via meta.yaml patch selector (set from bld.bat).
---
 torch/CMakeLists.txt | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/torch/CMakeLists.txt b/torch/CMakeLists.txt
index 0aac8f8..13d39fc 100644
--- a/torch/CMakeLists.txt
+++ b/torch/CMakeLists.txt
@@ -390,6 +390,15 @@ set_source_files_properties(
     PROPERTIES GENERATED TRUE
     )
 
+# Opt-in: compile torch_python in its own ninja job pool. Its generated
+# autograd-binding TUs (python_functions_N.cpp, python_torch_functions_N.cpp)
+# get a lower concurrency cap as a precaution (measured ~0.6GB each; the real
+# memory peak is the torch_cpu.dll link, not these). The pool itself is
+# declared by the caller via -DCMAKE_JOB_POOLS=<name>=<n>.
+if(TORCH_PYTHON_JOB_POOL)
+  set_property(TARGET torch_python PROPERTY JOB_POOL_COMPILE ${TORCH_PYTHON_JOB_POOL})
+endif()
+
 # Disable certain warnings for GCC-9.X
 if(CMAKE_COMPILER_IS_GNUCXX)
   set_source_files_properties(${TORCH_SRC_DIR}/csrc/Module.cpp PROPERTIES COMPILE_FLAGS "-Wno-cast-function-type")
